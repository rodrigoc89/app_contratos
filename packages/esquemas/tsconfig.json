{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    // ─────────────────────────────────────────────────────────────────────
    // The two lines that keep this package browser-safe.
    // ─────────────────────────────────────────────────────────────────────
    // `lib` has no DOM and `types` is empty — no `@types/node`, no `document`.
    // A stray `import { readFile } from "node:fs"` or a `process.env` read
    // therefore fails `pnpm typecheck` here rather than at Vite build time in
    // the PWA, which is the only place it would otherwise surface.
    //
    // This is not decoration: DESIGN.md §5.1 makes this package the single
    // definition of DNI, MAC and phone validation for *both* sides. It is
    // only worth that if the client can actually import it.
    "lib": ["ES2023"],
    "types": [],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
