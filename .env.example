# Copy this file to apps/api/.env for local development.
#
# Prisma 7 no longer loads .env automatically: prisma.config.ts imports
# dotenv/config, which reads the .env of the directory the command runs in —
# apps/api for the prisma:* scripts.
#
# The API server itself does NOT read a .env file. It reads process.env once,
# at boot, through src/config/configuracion.ts, and refuses to start if
# anything below is missing or malformed. In production these come from
# systemd's EnvironmentFile=, not from a file the application opens.
#
# Real .env files are git-ignored and must never be committed.

# --------------------------------------------------------------- base de datos

DATABASE_URL="postgresql://contratos:contratos@localhost:5432/contratos?schema=public"

# Optional. docker-compose.yml already defaults to these same values, so a
# local Postgres starts without setting any of them. Override only if you need
# to — and keep DATABASE_URL above in sync by hand, because nothing checks that
# the two agree.
#
# POSTGRES_USER=contratos
# POSTGRES_PASSWORD=contratos
# POSTGRES_DB=contratos
# POSTGRES_PORT=5432

# -------------------------------------------------------------------- servidor

# TCP port the API listens on. Default: 3000
PORT=3000

# development | test | production. Default: development
NODE_ENV=development

# -------------------------------------------------------------- autenticación

# REQUIRED, and there is deliberately no default. A signing key with a fallback
# value is a signing key that everyone who has read this repository already
# has. The server refuses to boot without it. Minimum 32 characters.
#
# Generate one per environment:
#     openssl rand -base64 48
#
# Rotating it invalidates every access token at once. It does NOT invalidate
# refresh tokens — those are revoked per device, in the database, which is the
# whole point (see src/identidad/domain/TokenDeRefresco.ts): a lost tablet is
# recoverable without signing out every technician in the province.
JWT_SECRET="cambiar-esto-por-openssl-rand-base64-48-antes-de-usarlo"

# Access token lifetime, in minutes. Default: 15, hard maximum: 60.
# An access token cannot be revoked — it is verified by signature alone — so
# this number is how long a stolen one keeps working, and therefore how long
# "revoke that lost tablet" takes to actually bite.
JWT_ACCESO_MINUTOS=15

# Refresh token lifetime, in days. Default: 30.
# This is how often a technician has to type their password again.
JWT_REFRESH_DIAS=30

# Login attempts allowed per IP per minute before the API answers 429.
# Default: 5. Four roles and a handful of employees is a very small username
# space, which makes credential stuffing against this login realistic rather
# than theoretical.
LOGIN_INTENTOS_POR_MINUTO=5

# Set to true ONLY when the process really is behind Nginx (DESIGN.md §10).
# With it on and nothing proxying, any client can forge X-Forwarded-For and
# walk straight through the rate limit above. Default: false, which is
# correct for local development — nothing proxies this process here.
#
# Production is the opposite case: nginx terminates TLS and proxies every
# request to this one, so every client arrives from nginx's own address.
# Leaving CONFIAR_EN_PROXY=false there collapses the rate limiter onto that
# one proxy address (127.0.0.1) instead of the real client IP — one failed
# login from anyone locks out everyone, because the limiter can no longer
# tell technicians apart. Production MUST set CONFIAR_EN_PROXY=true.
CONFIAR_EN_PROXY=false

# ------------------------------------------------------- almacenamiento de PDF

# Root directory of the signed-PDF archive — the legal asset this system
# exists to produce (DESIGN.md §7). Default: var/documentos, relative to
# wherever the API runs. That default is obviously wrong for a server, which
# is what makes an operator set it: point production at a directory that
# gets backed up offsite (see deploy/README.md and deploy/backup.sh).
ALMACEN_DOCUMENTOS_RUTA=var/documentos

# ------------------------------------------------------------ semilla de datos

# Password for the initial `admin` user, used ONLY by `pnpm prisma:seed`.
#
# There is no default and there will not be one. If this is unset the seed
# creates no administrator at all and says so loudly — the template and the
# signatory still load. A default credential that reaches production is a
# breach, and the only reliable defence is to make it impossible to create one
# by accident; this is the same call the seed already makes about the
# placeholder comodante signature.
#
# Minimum 12 characters. Choose it yourself, set it for the one command, and
# prefer not to leave it sitting in a file:
#     SEED_ADMIN_PASSWORD='...' pnpm --filter @contratos/api prisma:seed
#
# SEED_ADMIN_PASSWORD=

# Optional. Defaults: admin / Administrador
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_NOMBRE=Administrador

# Password for the initial `tecnico` user, used ONLY by `pnpm prisma:seed`.
# Same rule as SEED_ADMIN_PASSWORD above: no default, and unset means the
# seed skips this account instead of inventing a credential. Minimum 12
# characters.
#
# SEED_TECNICO_PASSWORD=

# Optional. Defaults: tecnico / Técnico
# SEED_TECNICO_USERNAME=tecnico
# SEED_TECNICO_NOMBRE=Técnico

# SEED_OFICINA_PASSWORD=

#SEED_OFICINA_USERNAME=oficina
#SEED_OFICINA_NOMBRE=Oficina

# SEED_OFICINA2_PASSWORD=

#SEED_OFICINA2_USERNAME=oficina2
#SEED_OFICINA2_NOMBRE=Oficina 2
